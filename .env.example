# Copy to .env and fill in. Never commit .env.
MAKAO_API_BASE_URL=http://localhost:8080
# Support WhatsApp number, international format, digits only.
MAKAO_SUPPORT_WHATSAPP=
# Same Web client ID as the backend's GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Google Maps browser key (Maps JavaScript API and Geocoding API). Optional.
GOOGLE_MAPS_API_KEY=
# Same long random string as on the backend.
MAKAO_WEB_PROXY_KEY=
# true only behind exactly one proxy or load balancer.
MAKAO_TRUST_FORWARDED_FOR=false
